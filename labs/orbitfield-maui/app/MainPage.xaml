<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:Class="OrbitField.App.MainPage" BackgroundColor="#f3f6fa" Title="OrbitField">
 <ScrollView>
  <VerticalStackLayout Padding="24" Spacing="14">
   <Label Text="OrbitField" FontSize="32" FontAttributes="Bold" TextColor="#234d76"/>
   <Label Text="Offline work orders and reliable sync" FontSize="14"/>
   <Entry Placeholder="Task title" Text="{Binding Title}"/>
   <Entry Placeholder="Customer alias (no PII)" Text="{Binding CustomerAlias}"/>
   <Button Text="Create offline order" Command="{Binding CreateCommand}"/>
   <HorizontalStackLayout Spacing="12">
    <Button Text="Refresh" Command="{Binding RefreshCommand}"/>
    <Button Text="Sync pending" Command="{Binding SyncCommand}"/>
   </HorizontalStackLayout>
   <Label Text="{Binding Feedback}" TextColor="#40566a"/>
   <CollectionView ItemsSource="{Binding Orders}">
    <CollectionView.ItemTemplate>
     <DataTemplate>
      <Border Padding="14" Margin="0,6" BackgroundColor="White" Stroke="#dae3ee">
       <VerticalStackLayout Spacing="6">
        <Label Text="{Binding Title}" FontAttributes="Bold"/>
        <Label Text="{Binding CustomerAlias}" FontSize="12"/>
        <Label Text="{Binding Status}"/>
        <Label Text="{Binding SyncDisplay}" FontSize="11" TextColor="#6c7282"/>
        <Button Text="Advance status" Command="{Binding AdvanceCommand}"/>
       </VerticalStackLayout>
      </Border>
     </DataTemplate>
    </CollectionView.ItemTemplate>
   </CollectionView>
  </VerticalStackLayout>
 </ScrollView>
</ContentPage>
